---
import '../styles/global.css';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { site } from '../config/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const { titulo, descripcion = site.descripcion, imagen } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nombre}` : `${site.nombre} · Hay que jugar, hay que reír y hay que divertirse`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagenSocial = imagen && Astro.site ? new URL(imagen, Astro.site).href : undefined;
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#022E8B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {imagenSocial && <meta property="og:image" content={imagenSocial} />}
  </head>
  <body id="inicio">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Encabezado />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
