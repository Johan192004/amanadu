---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icono from '../../components/Icono.astro';
import TarjetaJuego from '../../components/TarjetaJuego.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { lineas } from '../../data/taxonomia';
import { fechaLarga, minutosLectura } from '../../lib/fechas';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((articulo) => ({ params: { slug: articulo.id }, props: { articulo } }));
}

interface Props {
  articulo: CollectionEntry<'articulos'>;
}

const { articulo } = Astro.props;
const { data } = articulo;
const { Content } = await render(articulo);
const linea = lineas[data.linea];
const minutos = minutosLectura(articulo.body ?? '');

const todosLosJuegos = await getCollection('juegos');
const juegos = data.juegosRelacionados
  .map((id) => todosLosJuegos.find((j) => j.id === id))
  .filter((j): j is CollectionEntry<'juegos'> => Boolean(j))
  .slice(0, 3);

const otros = (await getCollection('articulos'))
  .filter((a) => a.id !== articulo.id)
  .sort((a, b) => Number(b.data.linea === data.linea) - Number(a.data.linea === data.linea) || b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
---

<Base titulo={data.titulo} descripcion={data.entradilla} imagen={data.imagen.src}>
  <article>
    <header class="art-cabecera">
      <div class="contenedor art-cabecera__contenido">
        <nav class="migas" aria-label="Ruta de navegación">
          <a href="/conoce-y-aprende/"><Icono nombre="arrow-left" tamano={16} /> Conoce y aprende</a>
        </nav>
        <a class={`art-linea art-linea--${linea.color}`} href={`/conoce-y-aprende/?linea=${data.linea}`}>{linea.etiqueta}</a>
        <h1 class="titulo-xxl">{data.titulo}</h1>
        <p class="art-entradilla">{data.entradilla}</p>
        <p class="art-meta">
          <span><Icono nombre="clock" tamano={16} /> {minutos} min de lectura</span>
          <span>Publicado el <time datetime={data.fecha.toISOString().slice(0, 10)}>{fechaLarga(data.fecha)}</time></span>
        </p>
      </div>
    </header>

    <div class="contenedor">
      <Foto
        src={data.imagen.src}
        alt={data.imagen.alt}
        proporcion="16 / 8"
        prioridad
        icono="book-open"
        tono={linea.color}
        class="art-portada"
        sizes="(max-width: 1240px) 100vw, 1240px"
      />
    </div>

    <div class="contenedor art-cuerpo">
      <div class="prosa">
        <Content />
      </div>

      {
        data.imagenSecundaria && (
          <figure class="art-figura">
            <Foto
              src={data.imagenSecundaria.src}
              alt={data.imagenSecundaria.alt}
              proporcion="3 / 2"
              icono="image"
              tono="coral"
            />
            {data.imagenSecundaria.pie && <figcaption class="nota">{data.imagenSecundaria.pie}</figcaption>}
          </figure>
        )
      }

      {
        data.fuentes.length > 0 && (
          <section class="art-fuentes" aria-labelledby="fuentes-titulo">
            <h2 id="fuentes-titulo">
              <Icono nombre="list-checks" tamano={18} /> Fuentes consultadas
            </h2>
            <ul>
              {data.fuentes.map((f) => (
                <li>
                  {f.url ? (
                    <a href={f.url} target="_blank" rel="noopener noreferrer">
                      {f.titulo}
                      <Icono nombre="external-link" tamano={14} />
                      <span class="solo-lectores">(abre en otra pestaña)</span>
                    </a>
                  ) : (
                    f.titulo
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  {
    juegos.length > 0 && (
      <section class="seccion bloque-azul sobre-oscuro" aria-labelledby="juegos-titulo">
        <div class="contenedor">
          <div class="cabecera-seccion cabecera-seccion--fila">
            <div>
              <p class="antetitulo">De la lectura al juego</p>
              <h2 id="juegos-titulo" class="titulo-l">
                Juegos relacionados
              </h2>
            </div>
            <a class="boton boton--claro" href="/biblioteca/">
              Biblioteca de juegos <Icono nombre="arrow-right" tamano={18} />
            </a>
          </div>
          <div class="grilla grilla--3">
            {juegos.map((j) => (
              <TarjetaJuego juego={j} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    otros.length > 0 && (
      <section class="seccion" aria-labelledby="otros-titulo">
        <div class="contenedor">
          <div class="cabecera-seccion">
            <h2 id="otros-titulo" class="titulo-l">
              Siga leyendo
            </h2>
          </div>
          <div class="grilla grilla--3">
            {otros.map((a) => (
              <TarjetaArticulo articulo={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .art-cabecera {
    padding-block: 2rem clamp(2.5rem, 5vw, 3.5rem);
  }

  .art-cabecera__contenido {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 980px;
    margin-left: max(var(--margen), calc((100% - var(--ancho)) / 2));
  }

  .migas a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: var(--t-s);
    text-decoration: none;
  }

  .migas a:hover {
    text-decoration: underline;
  }

  .art-linea {
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    font-size: var(--t-xs);
    font-weight: 700;
    text-decoration: none;
  }

  .art-linea--naranja {
    background: var(--naranja);
    color: var(--azul);
  }

  .art-linea--coral {
    background: var(--coral);
    color: var(--azul);
  }

  .art-linea--verde {
    background: var(--verde);
    color: var(--hueso);
  }

  .art-linea--azul {
    background: var(--azul);
    color: var(--hueso);
  }

  .art-entradilla {
    max-width: 52ch;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    font-weight: 500;
  }

  .art-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--t-s);
    font-weight: 700;
  }

  .art-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .art-cabecera ~ .contenedor :global(.art-portada) {
    border: 2px solid var(--azul);
    border-radius: var(--radio);
  }

  @media (max-width: 700px) {
    .art-cabecera ~ .contenedor :global(.art-portada) {
      aspect-ratio: 4 / 3 !important;
    }
  }

  .art-cuerpo {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    justify-items: center;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .art-cuerpo > * {
    width: 100%;
    max-width: var(--ancho-texto);
  }

  .art-figura {
    max-width: 900px !important;
    margin: 0;
  }

  .art-figura :global(.foto) {
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    transform: rotate(-1deg);
  }

  .art-figura figcaption {
    margin-top: 1rem;
    color: var(--azul);
  }

  .art-fuentes {
    padding: 1.5rem;
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    background: var(--hueso-claro);
    font-size: var(--t-s);
  }

  .art-fuentes h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .art-fuentes ul {
    display: grid;
    gap: 0.6rem;
    padding-left: 1.2rem;
  }

  .art-fuentes a :global(.icono) {
    display: inline;
    vertical-align: -2px;
    margin-left: 0.2rem;
  }
</style>
