---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Logo from '../../components/Logo.astro';
import Forma from '../../components/Forma.astro';
import Pendiente from '../../components/Pendiente.astro';
import SubnavSobre from '../../components/SubnavSobre.astro';
import { site } from '../../config/site';
import { resolverPublico } from '../../lib/recursos';

const pdf = resolverPublico(site.manual.pdf);
const portada = resolverPublico(site.manual.portada);

// Nombres, significados y códigos tomados del manual de marca (pp. 18 a 21).
const colores = [
  {
    nombre: 'Mandarina alegre',
    grupo: 'Principal',
    significado: 'Es la creatividad, el optimismo, el ocio y el juego.',
    hex: '#FF702E',
    rgb: '255, 112, 46',
    cmyk: '0, 66, 81, 0',
    clase: 'naranja',
  },
  {
    nombre: 'Rey vivo',
    grupo: 'Principal',
    significado: 'Representa la confianza, los vínculos y los parches.',
    hex: '#022E8B',
    rgb: '2, 46, 139',
    cmyk: '100, 87, 20, 3',
    clase: 'azul',
  },
  {
    nombre: 'Bálsamo',
    grupo: 'Principal',
    significado: 'Se relaciona con la interacción, la emoción, la cercanía y la calidez.',
    hex: '#FF614F',
    rgb: '255, 97, 79',
    cmyk: '0, 73, 62, 0',
    clase: 'coral',
  },
  {
    nombre: 'Hueso',
    grupo: 'Secundario',
    significado: 'Aporta equilibrio a la paleta de colores y facilita el contraste.',
    hex: '#F2E9C5',
    rgb: '242, 233, 197',
    cmyk: '0, 4, 19, 5',
    clase: 'hueso',
  },
  {
    nombre: 'Tamal',
    grupo: 'Secundario',
    significado: 'Conecta con la fauna de Amanadu y la diversidad cultural de Colombia.',
    hex: '#2C5324',
    rgb: '44, 83, 36',
    cmyk: '82, 42, 100, 42',
    clase: 'verde',
  },
];

// Descripciones del manual de marca (pp. 23 a 25).
const tipografias = [
  {
    nombre: 'Erica One',
    uso: 'Principal · títulos y textos llamativos',
    descripcion: 'Una fuente amigable y llamativa que transmite energía sin verse muy pesada.',
    clase: 'titulo',
    muestra: 'Hay que jugar',
  },
  {
    nombre: 'Elms Sans',
    uso: 'Secundaria · textos largos',
    descripcion: 'Versátil, simple y cómoda de leer. Su peso varía según la intención del texto.',
    clase: 'texto',
    muestra: 'Juegos para recuperar el tiempo libre y compartirlo.',
  },
  {
    nombre: 'Mynerve',
    uso: 'Terciaria · textos juguetones y mensajes cortos',
    descripcion: 'Divertida y dinámica: transmite cercanía sin verse desordenada.',
    clase: 'nota',
    muestra: '¡No se deje comer de la rutina!',
  },
];

// Glosario y usos incorrectos del logo (pp. 14 y 17).
const conceptosLogo = [
  { termino: 'Geometrización', definicion: 'Las figuras que componen nuestro logo.' },
  { termino: 'Planimetría', definicion: 'Las medidas que relacionan cada elemento de nuestro logo.' },
  { termino: 'Área de seguridad', definicion: 'La cantidad de espacio libre alrededor de nuestro logo.' },
];

const usosIncorrectos = [
  'Rayarlo',
  'Modificar sus ángulos',
  'Cambiar sus colores',
  'Editar sus proporciones',
  'Modificar su opacidad',
  'Utilizar degradados',
  'Sobreponerle imágenes',
];

// Estilo de fotografía (p. 32).
const estiloFotografico = ['Textura', 'Nostalgia', 'Editorial', 'Espontáneas', 'Neutras', 'Serenidad'];
---

<Base
  titulo="Manual de marca"
  descripcion="Manual de marca de Amanadu: logotipo, colores y tipografías. Consulte o descargue el documento en PDF."
>
  <section class="portada-manual bloque-azul sobre-oscuro" aria-labelledby="manual-titulo">
    <div class="contenedor portada-manual__grilla">
      <div class="portada-manual__texto">
        <SubnavSobre />
        <p class="antetitulo">Sobre Amanadu</p>
        <h1 id="manual-titulo" class="titulo-mega">Manual de marca</h1>
        <p class="lead">
          Las reglas de juego de nuestra identidad: el documento que define cómo usar el logo, los colores, las
          tipografías y el tono de voz para que Amanadu se vea y se sienta igual en todas partes.
        </p>
        {
          pdf && (
            <div class="portada-manual__acciones">
              <a class="boton boton--naranja" href={pdf} download={site.manual.nombreDescarga}>
                <Icono nombre="download" tamano={18} /> Descargar PDF
              </a>
              <a class="boton boton--claro" href={pdf} target="_blank" rel="noopener">
                <Icono nombre="external-link" tamano={18} /> Abrir en otra pestaña
              </a>
            </div>
          )
        }
      </div>
      <div class="portada-manual__tapa">
        {
          portada ? (
            <figure class="tapa-real">
              <img
                src={portada}
                alt="Portada del manual de marca: la mascota de Amanadu guiñando un ojo sobre el nombre Amanadu, rodeada de ondas naranja, coral y hueso."
                width="1521"
                height="1075"
                fetchpriority="high"
              />
              <Forma tipo="estrella" class="tapa-real__estrella" color="var(--naranja)" />
            </figure>
          ) : (
            <div class="tapa" aria-hidden="true">
              <Logo variante="claro" class="tapa__logo" />
              <p class="tapa__titulo">Manual de marca</p>
              <Forma tipo="estrella" class="tapa__estrella" color="var(--naranja)" />
              <Forma tipo="circulo" class="tapa__circulo" color="var(--coral)" />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="basicos-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <p class="antetitulo">Lo básico</p>
        <h2 id="basicos-titulo" class="titulo-xl">Colores</h2>
        <p>Tres colores principales y dos secundarios, cada uno con su razón de ser.</p>
      </div>
      <ul class="colores">
        {
          colores.map((c) => (
            <li class={`color color--${c.clase}`}>
              <p class="color__grupo">{c.grupo}</p>
              <h3 class="color__nombre">{c.nombre}</h3>
              <p class="color__significado">{c.significado}</p>
              <dl class="color__codigos">
                <div>
                  <dt>HEX</dt>
                  <dd>{c.hex}</dd>
                </div>
                <div>
                  <dt>RGB</dt>
                  <dd>{c.rgb}</dd>
                </div>
                <div>
                  <dt>CMYK</dt>
                  <dd>{c.cmyk}</dd>
                </div>
              </dl>
              <button
                type="button"
                class="color__copiar"
                data-copiar={c.hex}
                aria-label={`Copiar el código ${c.hex} de ${c.nombre}`}
              >
                <Icono nombre="copy" tamano={16} /> <span data-copiar-texto aria-live="polite">Copiar HEX</span>
              </button>
            </li>
          ))
        }
      </ul>

      <h2 class="titulo-xl tipos-titulo">Tipografías</h2>
      <ul class="tipos">
        {
          tipografias.map((t) => (
            <li class="tipo">
              <p class="tipo__meta">
                <strong>{t.nombre}</strong> · {t.uso}
              </p>
              <p class={`tipo__muestra tipo__muestra--${t.clase}`}>{t.muestra}</p>
              <p class="tipo__descripcion">{t.descripcion}</p>
            </li>
          ))
        }
      </ul>

      <h2 class="titulo-xl tipos-titulo">Logo</h2>
      <div class="logos">
        <div class="logos__caja logos__caja--claro"><Logo /></div>
        <div class="logos__caja logos__caja--oscuro"><Logo variante="claro" /></div>
      </div>

      <div class="logo-reglas">
        <dl class="conceptos">
          {
            conceptosLogo.map((c) => (
              <div class="concepto">
                <dt>{c.termino}</dt>
                <dd>{c.definicion}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mane">
          <p class="nota mane__titulo">¡No sea mañé!</p>
          <h3 class="mane__subtitulo">Usos incorrectos del logo</h3>
          <ul class="mane__lista">
            {
              usosIncorrectos.map((u) => (
                <li>
                  <Icono nombre="x" tamano={16} /> {u}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <h2 class="titulo-xl tipos-titulo">Estilo de fotografía</h2>
      <p class="estilo__intro">Las fotos de Amanadu se reconocen por estas cualidades:</p>
      <ul class="estilo">
        {estiloFotografico.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>

  <section class="seccion bloque-hueso" aria-labelledby="documento-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion cabecera-seccion--fila">
        <div>
          <p class="antetitulo">Documento completo</p>
          <h2 id="documento-titulo" class="titulo-xl">El manual en PDF</h2>
        </div>
        {
          pdf && (
            <div class="documento__acciones">
              <a class="boton" href={pdf} download={site.manual.nombreDescarga}>
                <Icono nombre="download" tamano={18} /> Descargar
              </a>
              <a class="boton boton--claro" href={pdf} target="_blank" rel="noopener">
                <Icono nombre="external-link" tamano={18} /> Abrir
              </a>
            </div>
          )
        }
      </div>

      {
        pdf ? (
          <div class="visor" data-visor>
            <p class="cargando visor__cargando" data-visor-cargando>
              <span class="cargando__puntos" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              Cargando el manual…
            </p>
            <iframe src={`${pdf}#view=FitH`} title="Manual de marca de Amanadu (PDF)" loading="lazy" data-visor-marco />
            <p class="visor__ayuda">
              <Icono nombre="file-text" tamano={16} />
              ¿No ve el documento? Algunos celulares no muestran PDF dentro de la página.
              <a href={pdf} target="_blank" rel="noopener">
                Ábralo aquí
              </a>
              .
            </p>
          </div>
        ) : (
          <div class="estado-vacio">
            <Icono nombre="file-text" tamano={36} />
            <p class="titulo-l">El manual estará disponible muy pronto</p>
            <p>Estamos dándole los últimos toques. Mientras tanto, aquí arriba están los colores, las tipografías y el logo.</p>
            <Pendiente campo="archivo PDF del manual" donde={`public${site.manual.pdf}`} />
          </div>
        )
      }
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
    const texto = boton.querySelector<HTMLElement>('[data-copiar-texto]')!;
    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(boton.dataset.copiar!);
        texto.textContent = '¡Copiado!';
      } catch {
        texto.textContent = 'No se pudo copiar';
      }
      window.setTimeout(() => (texto.textContent = 'Copiar HEX'), 1800);
    });
  });

  const marco = document.querySelector<HTMLIFrameElement>('[data-visor-marco]');
  const cargando = document.querySelector<HTMLElement>('[data-visor-cargando]');
  if (marco && cargando) {
    marco.addEventListener('load', () => (cargando.hidden = true));
  }
</script>

<style>
  .portada-manual {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
  }

  .portada-manual__grilla {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 860px) {
    .portada-manual__grilla {
      grid-template-columns: 1fr;
    }
  }

  .portada-manual__texto {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .portada-manual__acciones,
  .documento__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tapa-real {
    position: relative;
    margin: 0;
    transform: rotate(2.5deg);
  }

  .tapa-real img {
    width: 100%;
    height: auto;
    border: 2px solid var(--hueso);
    border-radius: var(--radio);
    box-shadow: 14px 14px 0 var(--naranja);
  }

  .tapa-real :global(.tapa-real__estrella) {
    position: absolute;
    left: -1.5rem;
    bottom: -1.5rem;
    width: 4.5rem;
    animation: girar-tapa 18s linear infinite;
  }

  @keyframes girar-tapa {
    to {
      transform: rotate(360deg);
    }
  }

  .tapa {
    position: relative;
    display: grid;
    align-content: space-between;
    aspect-ratio: 3 / 4;
    max-width: 380px;
    margin-inline: auto;
    padding: 2rem;
    border: 2px solid var(--hueso);
    border-radius: 6px 22px 22px 6px;
    background: var(--verde);
    box-shadow: 14px 14px 0 var(--naranja);
    transform: rotate(3deg);
    overflow: hidden;
  }

  .tapa :global(.tapa__logo) {
    --logo-alto: 3rem;
    position: relative;
    z-index: 1;
  }

  .tapa__titulo {
    position: relative;
    z-index: 1;
    font-family: var(--f-titulo);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 0.95;
  }

  .tapa :global(.tapa__estrella) {
    position: absolute;
    right: 1.5rem;
    top: 35%;
    width: 4.5rem;
  }

  .tapa :global(.tapa__circulo) {
    position: absolute;
    left: -3rem;
    bottom: 20%;
    width: 9rem;
    opacity: 0.9;
  }

  .colores {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    list-style: none;
  }

  @media (max-width: 900px) {
    .colores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .color {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.25rem;
    border: 2px solid var(--azul);
    border-radius: var(--radio);
  }

  .color--naranja {
    background: var(--naranja);
    color: var(--azul);
  }

  .color--azul {
    background: var(--azul);
    color: var(--hueso);
  }

  .color--coral {
    background: var(--coral);
    color: var(--azul);
  }

  .color--hueso {
    background: var(--hueso);
    color: var(--azul);
  }

  .color--verde {
    background: var(--verde);
    color: var(--hueso);
  }

  .color__grupo {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .color__nombre {
    font-size: 1.45rem;
    line-height: 1;
  }

  .color__significado {
    font-size: var(--t-s);
    line-height: 1.4;
  }

  .color__codigos {
    display: grid;
    gap: 0.15rem;
    margin: auto 0 0;
    padding-top: 0.75rem;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
  }

  .color__codigos div {
    display: flex;
    gap: 0.5rem;
  }

  .color__codigos dt {
    min-width: 2.75rem;
    font-weight: 800;
  }

  .color__codigos dd {
    margin: 0;
  }

  .color__copiar {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: var(--t-xs);
    font-weight: 700;
    cursor: pointer;
  }

  .color__copiar:hover {
    background: color-mix(in srgb, currentColor 15%, transparent);
  }

  .tipos-titulo {
    margin: clamp(3rem, 6vw, 4.5rem) 0 1.5rem;
  }

  .tipos {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .tipo {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-bottom: 2px solid var(--azul);
  }

  .tipo__meta {
    font-size: var(--t-s);
  }

  .tipo__descripcion {
    max-width: 60ch;
    font-size: var(--t-s);
  }

  .tipo__muestra--titulo {
    font-family: var(--f-titulo);
    font-size: var(--t-xxl);
    line-height: 1;
  }

  .tipo__muestra--texto {
    font-size: var(--t-l);
    line-height: 1.3;
  }

  .tipo__muestra--nota {
    font-family: var(--f-nota);
    font-size: var(--t-xl);
    color: var(--coral);
    line-height: 1.1;
  }

  .logos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .logos {
      grid-template-columns: 1fr;
    }
  }

  .logos__caja {
    --logo-alto: 4rem;
    display: grid;
    place-items: center;
    min-height: 14rem;
    border: 2px solid var(--azul);
    border-radius: var(--radio);
  }

  .logos__caja--claro {
    background: var(--hueso-claro);
  }

  .logos__caja--oscuro {
    background: var(--azul);
  }

  .logo-reglas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 760px) {
    .logo-reglas {
      grid-template-columns: 1fr;
    }
  }

  .conceptos {
    display: grid;
    gap: 1rem;
    margin: 0;
    align-content: start;
  }

  .concepto {
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--azul);
  }

  .concepto dt {
    font-family: var(--f-titulo);
    font-size: 1.3rem;
  }

  .concepto dd {
    margin: 0.25rem 0 0;
  }

  .mane {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    background: var(--coral);
    color: var(--azul);
  }

  .mane__titulo {
    color: var(--azul) !important;
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .mane__subtitulo {
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mane__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 0.5rem 1rem;
    list-style: none;
    margin-top: 0.5rem;
    font-weight: 700;
  }

  .mane__lista li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .estilo__intro {
    margin-bottom: 1rem;
  }

  .estilo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
  }

  .estilo li {
    padding: 0.5rem 1.25rem;
    border: 2px solid var(--azul);
    border-radius: 999px;
    font-family: var(--f-titulo);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
  }

  .estilo li:nth-child(3n + 1) {
    background: var(--naranja);
  }

  .estilo li:nth-child(3n + 2) {
    background: var(--azul);
    color: var(--hueso);
  }

  .estilo li:nth-child(3n) {
    background: var(--hueso-claro);
  }

  .visor {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .visor iframe {
    width: 100%;
    height: min(85vh, 960px);
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    background: var(--hueso-claro);
  }

  .visor__cargando {
    position: absolute;
    left: 50%;
    top: 40%;
    transform: translateX(-50%);
  }

  .visor__ayuda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-s);
  }

  .visor__ayuda a {
    font-weight: 700;
  }
</style>
