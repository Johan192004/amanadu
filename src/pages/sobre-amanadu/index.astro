---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icono from '../../components/Icono.astro';
import Forma from '../../components/Forma.astro';
import Eslogan from '../../components/Eslogan.astro';
import Pendiente from '../../components/Pendiente.astro';
import SubnavSobre from '../../components/SubnavSobre.astro';
import { nosotras } from '../../data/nosotras';
import { pilares } from '../../data/pilares';

const tonos = ['naranja', 'azul', 'coral', 'verde'] as const;
---

<Base
  titulo="Nosotras"
  descripcion="Conozca Amanadu: una invitación a recuperar el juego, la risa, el tiempo libre y la conexión con los demás."
>
  <section class="nos-cabecera" aria-labelledby="nos-titulo">
    <div class="contenedor nos-cabecera__grilla">
      <div class="nos-cabecera__texto">
        <SubnavSobre />
        <p class="antetitulo">Sobre Amanadu</p>
        <h1 id="nos-titulo" class="titulo-mega">Nosotras</h1>
        {nosotras.identidad.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
      </div>
      <div class="nos-cabecera__foto">
        <Foto
          src={nosotras.fotoPrincipal.src}
          alt={nosotras.fotoPrincipal.alt}
          proporcion="3 / 2"
          prioridad
          icono="users"
          tono="coral"
        />
        <Forma tipo="onda" class="nos-cabecera__onda" color="var(--naranja)" />
        <p class="nota nos-cabecera__nombres">{nosotras.fotoPrincipal.pie}</p>
      </div>
    </div>
  </section>

  <section class="seccion bloque-azul sobre-oscuro" aria-labelledby="proposito-titulo">
    <div class="contenedor proposito">
      <div>
        <p class="antetitulo">Propósito</p>
        <p class="nota">En pocas palabras:</p>
        <h2 id="proposito-titulo" class="titulo-l proposito__frase">{nosotras.proposito.enPocasPalabras}</h2>
      </div>
      <div class="proposito__texto">
        <h3 class="proposito__subtitulo">¿Qué nos llamó la atención?</h3>
        <p>{nosotras.proposito.loQueNosLlamoLaAtencion}</p>
        <h3 class="proposito__subtitulo">Entonces proponemos…</h3>
        <p>{nosotras.proposito.proponemos}</p>
        <Eslogan class="proposito__eslogan" />
      </div>
    </div>
  </section>

  <section class="seccion" aria-label="Misión y visión">
    <div class="contenedor mision-vision">
      <article class="mv bloque-naranja">
        <Icono nombre="flag" tamano={30} />
        <h2 class="titulo-l">Misión</h2>
        <p>{nosotras.mision}</p>
      </article>
      <article class="mv bloque-verde sobre-oscuro">
        <Icono nombre="sparkles" tamano={30} />
        <h2 class="titulo-l">Visión</h2>
        <p>{nosotras.vision}</p>
      </article>
    </div>
  </section>

  <section class="seccion" aria-labelledby="principios-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <p class="antetitulo">Lo que nos mueve</p>
        <h2 id="principios-titulo" class="titulo-xl">Nuestros pilares</h2>
      </div>
      <ul class="principios">
        {
          pilares.map((p, i) => (
            <li class={`principio bloque-${tonos[i % tonos.length]}`}>
              <Icono nombre={p.icono} tamano={30} />
              <h3>{p.nombre}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion bloque-hueso" aria-labelledby="origen-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <p class="antetitulo">De dónde venimos</p>
        <h2 id="origen-titulo" class="titulo-xl">Un nombre y una manada</h2>
      </div>
      <div class="origen">
        <article class="origen__nombre">
          <h3 class="origen__titulo">El nombre</h3>
          <p class="definicion">
            <span class="definicion__palabra">{nosotras.origen.nombre.palabra}</span>
            <span class="definicion__marca">{nosotras.origen.nombre.marca}</span>
          </p>
          <p class="definicion__texto"><strong>1.</strong> {nosotras.origen.nombre.definicion}</p>
          <p class="nota definicion__ejemplo">«{nosotras.origen.nombre.ejemplo}»</p>
        </article>
        <article class="origen__mascota">
          <h3 class="origen__titulo">Cómo nació {nosotras.origen.mascota.nombre}</h3>
          {nosotras.origen.mascota.texto.map((p) => <p>{p}</p>)}
        </article>
      </div>
    </div>
  </section>

  {
    (nosotras.equipo.length > 0 || import.meta.env.DEV) && (
      <section class="seccion" aria-labelledby="equipo-titulo">
        <div class="contenedor">
          <div class="cabecera-seccion">
            <p class="antetitulo">Equipo</p>
            <h2 id="equipo-titulo" class="titulo-xl">
              Quiénes estamos detrás
            </h2>
          </div>
          {nosotras.equipo.length > 0 ? (
            <ul class="grilla grilla--4 equipo">
              {nosotras.equipo.map((persona, i) => (
                <li class="integrante">
                  <Foto
                    src={persona.foto}
                    alt={`Retrato de ${persona.nombre}`}
                    proporcion="1 / 1"
                    icono="user"
                    tono={tonos[i % tonos.length]}
                  />
                  <h3>{persona.nombre}</h3>
                  <p class="integrante__rol">{persona.rol}</p>
                  {persona.bio && <p>{persona.bio}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <Pendiente campo="integrantes del equipo (nombre, rol, foto y bio)" donde="src/data/nosotras.ts → equipo" />
          )}
        </div>
      </section>
    )
  }

  <section class="seccion bloque-naranja" aria-labelledby="sigue-titulo">
    <div class="contenedor sigue">
      <h2 id="sigue-titulo" class="titulo-xl">¿Y ahora qué?</h2>
      <div class="sigue__acciones">
        <a class="boton" href="/biblioteca/">
          <Icono nombre="library" tamano={18} /> Explore la Biblioteca de juegos
        </a>
        <a class="boton boton--claro" href="/sobre-amanadu/manual-de-marca/">
          <Icono nombre="book-open" tamano={18} /> Vea el manual de marca
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nos-cabecera {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .nos-cabecera__grilla {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 960px) {
    .nos-cabecera__grilla {
      grid-template-columns: 1fr;
    }
  }

  .nos-cabecera__texto {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .nos-cabecera__texto > p:not(.lead):not(.antetitulo) {
    max-width: 52ch;
  }

  .nos-cabecera__foto {
    position: relative;
  }

  .nos-cabecera__foto :global(.foto) {
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    box-shadow: 10px 10px 0 var(--coral);
    transform: rotate(1.5deg);
  }

  .nos-cabecera__nombres {
    position: absolute;
    right: 1.5rem;
    bottom: -1.25rem;
    z-index: 4;
    padding: 0.3rem 1.1rem 0.45rem;
    border: 2px solid var(--azul);
    border-radius: 999px;
    background: var(--naranja);
    color: var(--azul) !important;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    transform: rotate(-4deg);
  }

  .nos-cabecera__foto :global(.nos-cabecera__onda) {
    position: absolute;
    left: -2rem;
    top: -1.5rem;
    z-index: 3;
    width: 5.5rem;
  }

  .proposito {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
  }

  @media (max-width: 860px) {
    .proposito {
      grid-template-columns: 1fr;
    }
  }

  .proposito > div:first-child {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .proposito__texto {
    display: grid;
    gap: 1.25rem;
    font-size: 1.15rem;
  }

  .proposito__texto :global(.proposito__eslogan) {
    margin-top: 1rem;
    font-family: var(--f-titulo);
    font-size: var(--t-l);
    line-height: 1.05;
  }

  .principios {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
    list-style: none;
  }

  .principio {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 2px solid var(--azul);
    border-radius: var(--radio);
  }

  .principio:nth-child(odd) {
    transform: rotate(-0.8deg);
  }

  .principio:nth-child(even) {
    transform: rotate(0.8deg);
  }

  .principio h3 {
    font-size: var(--t-m);
  }

  .proposito__frase {
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    line-height: 1;
  }

  .proposito__subtitulo {
    margin-top: 0.5rem;
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--naranja);
  }

  .mision-vision {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 760px) {
    .mision-vision {
      grid-template-columns: 1fr;
    }
  }

  .mv {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    box-shadow: 8px 8px 0 var(--azul);
    font-size: 1.1rem;
  }

  .origen {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  @media (max-width: 760px) {
    .origen {
      grid-template-columns: 1fr;
    }
  }

  .origen article {
    display: grid;
    gap: 1rem;
    align-content: start;
    font-size: 1.1rem;
  }

  .origen__titulo {
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Entrada de diccionario para «amañado» */
  .origen__nombre {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    background: var(--hueso);
  }

  .definicion {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .definicion__palabra {
    font-family: var(--f-titulo);
    font-size: var(--t-xl);
    line-height: 1;
  }

  .definicion__marca {
    font-style: italic;
    font-weight: 600;
  }

  .definicion__ejemplo {
    color: var(--coral);
  }

  .equipo {
    list-style: none;
  }

  .integrante {
    display: grid;
    gap: 0.5rem;
  }

  .integrante :global(.foto) {
    border: 2px solid var(--azul);
    border-radius: var(--radio);
    margin-bottom: 0.5rem;
  }

  .integrante h3 {
    font-size: 1.4rem;
  }

  .integrante__rol {
    font-weight: 700;
    color: var(--verde);
  }

  .sigue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .sigue__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
