---
/**
 * Logo oficial de Amanadu.
 * - tipo «secundario»: horizontal (mascota a la izquierda). Para el encabezado y espacios bajos.
 * - tipo «principal»: mascota sobre la palabra. Para el pie y espacios amplios.
 * - fondo «claro» sobre hueso; «color» sobre azul, verde o naranja.
 * Si un archivo no existe, se muestra un logotipo tipográfico provisional.
 */
import { site } from '../config/site';
import { resolverPublico } from '../lib/recursos';

interface Props {
  tipo?: 'principal' | 'secundario';
  fondo?: 'claro' | 'color';
  class?: string;
  /** Carga inmediata (por ejemplo, en el encabezado). */
  prioridad?: boolean;
}

const { tipo = 'secundario', fondo = 'claro', class: clase, prioridad = false } = Astro.props;
const archivo = resolverPublico(site.logo[tipo][fondo]) ?? resolverPublico(site.logo[tipo].claro);
const medidas = site.logo[tipo].medidas;
---

{
  archivo ? (
    <img
      src={archivo}
      alt={site.logo.alt}
      class:list={['logo', `logo--${tipo}`, clase]}
      width={medidas[0]}
      height={medidas[1]}
      loading={prioridad ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <span class:list={['logo', 'logo--texto', `logo--fondo-${fondo}`, clase]}>
      <span class="solo-lectores">{site.nombre}</span>
      <span aria-hidden="true">amanadu</span>
    </span>
  )
}

<style>
  .logo {
    display: block;
    height: var(--logo-alto, 2.5rem);
    width: auto;
  }

  .logo--texto {
    display: inline-flex;
    align-items: center;
    height: auto;
    font-family: var(--f-titulo);
    font-size: calc(var(--logo-alto, 2.5rem) * 0.82);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--azul);
  }

  .logo--fondo-color {
    color: var(--hueso);
  }
</style>
