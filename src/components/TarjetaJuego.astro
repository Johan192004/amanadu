---
import type { CollectionEntry } from 'astro:content';
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { categorias, complejidades } from '../data/taxonomia';
import { duracionTexto, rangoTexto } from '../lib/coincidencias';

interface Props {
  juego: CollectionEntry<'juegos'>;
  /** Nivel del título según el contexto de la página. */
  nivel?: 'h2' | 'h3';
  /** Incluye los datos para filtrar y el espacio para explicar la recomendación. */
  filtrable?: boolean;
}

const { juego, nivel = 'h3', filtrable = false } = Astro.props;
const { data, id } = juego;
const Titulo = nivel;
const categoria = categorias[data.categorias[0]];
const tonos = ['azul', 'naranja', 'verde', 'coral'] as const;
const tono = tonos[[...id].reduce((a, c) => a + c.charCodeAt(0), 0) % tonos.length];

const datosFiltro = filtrable
  ? {
      'data-juego': id,
      'data-nombre': data.nombre,
      'data-categorias': data.categorias.join(' '),
      'data-lugares': data.lugares.join(' '),
      'data-planes': data.planes.join(' '),
      'data-jugadores': `${data.jugadores.min}-${data.jugadores.max}`,
      'data-duracion': `${data.duracion.min}-${data.duracion.max}`,
    }
  : {};
---

<article class="tarjeta tarjeta-juego" {...datosFiltro}>
  <Foto
    src={data.imagen.src}
    alt={data.imagen.alt}
    proporcion="4 / 3"
    icono={categoria.icono}
    tono={tono}
    sizes="(max-width: 700px) 100vw, 400px"
  />
  <div class="tarjeta-juego__cuerpo">
    <p class="tarjeta-juego__categoria">
      <Icono nombre={categoria.icono} tamano={16} />
      {categoria.corta}
    </p>
    <Titulo class="tarjeta-juego__nombre">
      <a class="tarjeta__enlace" href={`/biblioteca/${id}/`}>{data.nombre}</a>
    </Titulo>
    <p class="tarjeta-juego__gancho">{data.gancho}</p>
    {filtrable && <p class="tarjeta-juego__porque" data-porque hidden />}
    <ul class="tarjeta-juego__datos" aria-label="Datos del juego">
      <li>
        <Icono nombre="users" tamano={16} />
        <span class="solo-lectores">Participantes:</span>
        {rangoTexto(data.jugadores, 'persona')}
      </li>
      <li>
        <Icono nombre="clock" tamano={16} />
        <span class="solo-lectores">Duración:</span>
        {duracionTexto(data.duracion)}
      </li>
      <li>
        <Icono nombre="gauge" tamano={16} />
        <span class="solo-lectores">Complejidad:</span>
        {complejidades[data.complejidad]}
      </li>
    </ul>
  </div>
</article>

<style>
  .tarjeta-juego__cuerpo {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    flex: 1;
    padding: 1.1rem 1.25rem 1.3rem;
    border-top: 2px solid var(--azul);
  }

  .tarjeta-juego__categoria {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--verde);
  }

  .tarjeta-juego__nombre {
    font-size: clamp(1.5rem, 2.4vw, 1.85rem);
    line-height: 1;
  }

  .tarjeta-juego__gancho {
    font-size: var(--t-s);
    line-height: 1.45;
  }

  .tarjeta-juego__porque {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radio-s);
    background: color-mix(in srgb, var(--naranja) 22%, transparent);
    font-size: var(--t-s);
    line-height: 1.4;
  }

  .tarjeta-juego__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 0.4rem;
    list-style: none;
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .tarjeta-juego__datos li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
